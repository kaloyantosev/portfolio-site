//@version=6
indicator(title="Stoch + ATR Ticks + DMI Matrix (Unified Alert Suite)", shorttitle="Stoch+ATR+DMI+MA_Filtered", overlay=false)

// ==========================================
// --- INPUT CONFIGURATIONS ---
// ==========================================
// 1. Stochastic Inputs
var string G_STOCH = "STOCHASTIC SETTINGS"
smoothK   = input.int(5, title="Stoch Length (K)", minval=1, group=G_STOCH)

// 2. ATR Inputs
var string G_ATR = "AVERAGE TRUE RANGE SETTINGS"
atrLength = input.int(14, title="ATR Length", minval=1, group=G_ATR)
smoothing = input.string("RMA", title="ATR Smoothing", options=["RMA", "SMA", "EMA", "WMA"], group=G_ATR)

// 3. ADX & DMI Inputs
var string G_ADX = "DMI SETTINGS"
showDMI      = input.bool(true, "Plot +DI & -DI Lines", group=G_ADX)
showTable    = input.bool(true, "Show Posture Side Table", group=G_ADX)
diLen        = input.int(14, title="DI Smoothing Length (dilen)", group=G_ADX)
adxLen       = input.int(14, title="Internal ADX Smoothing (adxlen)", group=G_ADX)
adxThresh    = input.int(25, title="ADX Min Threshold (Trending)", group=G_ADX)
adxMaxThresh = input.int(40, title="ADX Max Threshold (Overextended)", group=G_ADX)
minDmiSpread = input.float(7.0, title="Minimum DMI Spread for Alerts", minval=0.0, group=G_ADX)

// 4. Moving Average Background Trend Inputs
var string G_MA = "BACKGROUND MOVING AVERAGE FILTERS"
lenFast   = input.int(20, title="Fast EMA Length", minval=1, group=G_MA)
lenSlow   = input.int(50, title="Slow EMA Length", minval=1, group=G_MA)

// 5. Time Window Settings (Fixed on London backdrop to properly match your Bulgarian Time offsets)
var string G_TIME = "ALERT CLOCK CONTROLS"
tzLocation   = input.string("Europe/London", "Alert Timezone Reference", group=G_TIME)

// ==========================================
// --- ENGINE CALCULATIONS ---
// ==========================================
// 1. Single Line Slow Stochastic Math
rawStoch = ta.stoch(close, high, low, smoothK)
singleK  = ta.sma(rawStoch, 3)

// 2. Average True Range Math
ma_function(source, len) =>
    switch smoothing
        "RMA" => ta.rma(source, len)
        "SMA" => ta.sma(source, len)
        "EMA" => ta.ema(source, len)
        => ta.wma(source, len)

atrValue = ma_function(ta.tr(true), atrLength)

// 3. Dual Axis Normalization Matrix (For Visual ATR Alignment)
highestATR    = ta.highest(atrValue, 100)
lowestATR     = ta.lowest(atrValue, 100)
normalizedATR = ((atrValue - lowestATR) / math.max(highestATR - lowestATR, 0.00001)) * 100

// 4. Native v6 Mathematical Framework for DMI components & Spread Calculation
[plusDI, minusDI, adxValue] = ta.dmi(diLen, adxLen)
currentDmiSpread            = math.abs(plusDI - minusDI)

// 5. Background Moving Average Logic (Calculating EMAs behind the scenes)
ema20 = ta.ema(close, lenFast)
ema50 = ta.ema(close, lenSlow)

// Persistent state variable tracking the absolute most recent cross directional context
var int recentMaTrendState = 0

if ta.crossover(ema20, ema50)
    recentMaTrendState := 1
if ta.crossunder(ema20, ema50)
    recentMaTrendState := -1

// ==========================================================
// --- ULTIMATE TIME, BOUNDARY, DMI & MA FILTER MATRIX ---
// ==========================================================
// Isolate clock elements relative to London timezone location
currentHour   = hour(time, tzLocation)
currentMinute = minute(time, tzLocation)

// Precise Time Window mapped to London reference point:
// 04:55 AM London (= 06:55 AM BG Time) to 21:00 PM London (= 23:00 PM BG Time)
isAfter455AM = (currentHour == 4 and currentMinute >= 55) or (currentHour >= 5)
isBefore21PM = (currentHour < 21)
timeWindowActive = isAfter455AM and isBefore21PM

// Check strict numeric threshold boundaries (Filters out values like 69.99 or 30.01)
stochCrossedLong  = (singleK > 70.0) and (singleK[1] <= 70.0)
stochCrossedShort = (singleK < 30.0) and (singleK[1] >= 30.0)

// DMI Directional Filters
dmiBullishTrend = plusDI > minusDI  // Green above Red
dmiBearishTrend = minusDI > plusDI  // Red above Green

// New Spread Filter: Must be strictly above the updated threshold of 7
spreadFilterActive = currentDmiSpread > minDmiSpread

// MA Trend State Filters (Must match the most recent directional cross state)
maBullishTrendActive = (recentMaTrendState == 1)
maBearishTrendActive = (recentMaTrendState == -1)

// Final Compound Signal Compilation
triggerLongAlert  = timeWindowActive and stochCrossedLong and dmiBullishTrend and maBullishTrendActive and spreadFilterActive
triggerShortAlert = timeWindowActive and stochCrossedShort and dmiBearishTrend and maBearishTrendActive and spreadFilterActive

// ==========================================
// --- UNIFIED EXECUTION ALERT ENGINE ---
// ==========================================
alertcondition(triggerLongAlert,  title="Long Signal",  message="{{ticker}} LONG: Stoch crossed above 70 with +DI > -DI, EMA 20/50 bullish and DMI spread above minimum")
alertcondition(triggerShortAlert, title="Short Signal", message="{{ticker}} SHORT: Stoch crossed below 30 with -DI > +DI, EMA 20/50 bearish and DMI spread above minimum")

// ==========================================
// --- PLOTTING ---
// ==========================================
hline(70, "Long Trigger (70)",  color=color.new(color.gray, 50), linestyle=hline.style_dashed)
hline(30, "Short Trigger (30)", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

plot(normalizedATR, "ATR (normalised 0-100)", color=color.new(#C9A96E, 45), linewidth=1)
plot(showDMI ? plusDI : na,  "+DI", color=color.new(#2E9E6B, 20), linewidth=1)
plot(showDMI ? minusDI : na, "-DI", color=color.new(#C2453D, 20), linewidth=1)
plot(adxValue, "ADX", color=color.new(color.white, 65), linewidth=1)
plot(singleK, "Stoch %K", color=#4C8DD9, linewidth=2)

plotshape(triggerLongAlert,  title="Long Signal",  style=shape.triangleup,   location=location.bottom, color=#2E9E6B, size=size.tiny)
plotshape(triggerShortAlert, title="Short Signal", style=shape.triangledown, location=location.top,    color=#C2453D, size=size.tiny)

// ==========================================
// --- POSTURE SIDE TABLE ---
// ==========================================
var table posture = table.new(position.top_right, 2, 5, bgcolor=color.new(#0B0F17, 10), border_width=1, border_color=color.new(color.white, 90))

if showTable and barstate.islast
    txt  = #D9DDE3
    bull = #2E9E6B
    bear = #C2453D
    adxState = adxValue >= adxMaxThresh ? "Overextended" : adxValue >= adxThresh ? "Trending" : "No trend"
    adxColor = adxValue >= adxMaxThresh ? #C9A96E : adxValue >= adxThresh ? txt : color.new(txt, 50)
    table.cell(posture, 0, 0, "DMI",       text_color=color.new(txt, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(posture, 1, 0, (dmiBullishTrend ? "Bullish" : dmiBearishTrend ? "Bearish" : "Flat") + "  Δ" + str.tostring(currentDmiSpread, "0.0"), text_color=dmiBullishTrend ? bull : dmiBearishTrend ? bear : txt, text_size=size.small)
    table.cell(posture, 0, 1, "ADX",       text_color=color.new(txt, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(posture, 1, 1, str.tostring(adxValue, "0.0") + "  " + adxState, text_color=adxColor, text_size=size.small)
    table.cell(posture, 0, 2, "EMA 20/50", text_color=color.new(txt, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(posture, 1, 2, maBullishTrendActive ? "Bullish" : maBearishTrendActive ? "Bearish" : "No cross yet", text_color=maBullishTrendActive ? bull : maBearishTrendActive ? bear : txt, text_size=size.small)
    table.cell(posture, 0, 3, "Stoch %K",  text_color=color.new(txt, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(posture, 1, 3, str.tostring(singleK, "0.0"), text_color=txt, text_size=size.small)
    table.cell(posture, 0, 4, "Alert window", text_color=color.new(txt, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(posture, 1, 4, timeWindowActive ? "Open" : "Closed", text_color=timeWindowActive ? bull : color.new(txt, 50), text_size=size.small)
